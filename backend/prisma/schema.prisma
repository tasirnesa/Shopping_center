generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// TENANT ROOT
// ─────────────────────────────────────────────────────────────

model Organization {
  id           String   @id @default(uuid())
  name         String
  businessType String?  // RETAIL, SUPERMARKET, PHARMACY, HARDWARE, etc.
  tin          String?  // Tax Identification Number
  phone        String?
  email        String?
  address      String?
  logo         String?
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  branches   Branch[]
  users      User[]
  products   Product[]
  categories Category[]
  brands     Brand[]
  units      Unit[]
  suppliers  Supplier[]
  customers  Customer[]
  sales      Sale[]
  purchases  Purchase[]
  expenses   Expense[]
  settings   OrganizationSettings?
}

model OrganizationSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency       String       @default("ETB")
  taxRate        Float        @default(15)
  receiptFooter  String?
  language       String       @default("en")
  fiscalYear     String?
  timezone       String       @default("Africa/Addis_Ababa")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ─────────────────────────────────────────────────────────────
// BRANCH
// ─────────────────────────────────────────────────────────────

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  phone          String?
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  users                 User[]
  stockBalances         StockBalance[]
  inventoryTransactions InventoryTransaction[]
  expenses              Expense[]
  sales                 Sale[]
  purchases             Purchase[]
}

// ─────────────────────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────────────────────

model User {
  id             String       @id @default(uuid())
  organizationId String?      // null for SYSTEM_ADMIN
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?      // null for OWNER (has access to all branches)
  branch         Branch?      @relation(fields: [branchId], references: [id])
  email          String       @unique
  password       String
  name           String?
  role           Role         @default(CASHIER)
  status         String       @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum Role {
  SYSTEM_ADMIN
  OWNER
  MANAGER
  CASHIER
  STORE_KEEPER
}

// ─────────────────────────────────────────────────────────────
// MASTER DATA (all scoped to Organization)
// ─────────────────────────────────────────────────────────────

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  products       Product[]
}

model Brand {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  products       Product[]
}

model Unit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       // e.g. kg, pcs, box
  products       Product[]
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  barcode        String?      @unique
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  unitId         String?
  unit           Unit?        @relation(fields: [unitId], references: [id])
  price          Float
  cost           Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  saleDetails           SaleDetail[]
  purchaseDetails       PurchaseDetail[]
  stockBalances         StockBalance[]
  inventoryTransactions InventoryTransaction[]
  priceHistories        PriceHistory[]
  returnDetails         ReturnDetail[]
}

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contact        String?
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  purchases      Purchase[]
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sales          Sale[]
}

// ─────────────────────────────────────────────────────────────
// PURCHASING
// ─────────────────────────────────────────────────────────────

model Purchase {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id])
  totalAmount    Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  details        PurchaseDetail[]
}

model PurchaseDetail {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  cost       Float
}

// ─────────────────────────────────────────────────────────────
// SALES
// ─────────────────────────────────────────────────────────────

model Sale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  subTotal       Float        @default(0)
  discount       Float        @default(0)
  totalAmount    Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  details        SaleDetail[]
  returns        Return[]
}

model SaleDetail {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

// ─────────────────────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────────────────────

model StockBalance {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model InventoryTransaction {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  type      String   // IN or OUT
  quantity  Int
  reference String?  // e.g. Sale ID or Purchase ID
  createdAt DateTime @default(now())
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  oldPrice  Float
  newPrice  Float
  changedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────────────────────

model Payment {
  id            String   @id @default(uuid())
  referenceId   String   // saleId or purchaseId
  referenceType String   // SALE or PURCHASE
  amount        Float
  method        String   // CASH, CARD, TRANSFER
  createdAt     DateTime @default(now())
}

model Expense {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  description    String
  amount         Float
  date           DateTime     @default(now())
  createdAt      DateTime     @default(now())
}

// ─────────────────────────────────────────────────────────────
// RETURNS
// ─────────────────────────────────────────────────────────────

model Return {
  id          String         @id @default(uuid())
  saleId      String
  sale        Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  totalRefund Float
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  details     ReturnDetail[]
}

model ReturnDetail {
  id        String  @id @default(uuid())
  returnId  String
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}
